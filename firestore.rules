rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 120 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 15)) &&
             (!('balance' in data) || data.balance == null || (data.balance is int && data.balance >= 0 && data.balance <= 100000000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'fullName', 'username', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'username', 'phone', 'balance', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'username', 'phone', 'balance', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
